# انسخ هذا الملف إلى .env ثم ضع القيم. لا تضع أي مفتاح حقيقي هنا.

# ===== أساسي =====
# مطلوب للمساعد الذكي واستخراج PDF وفحص الأدلة
ANTHROPIC_API_KEY=
# النموذج المستخدم (افتراضي سونيت 4.6 — مناسب وسريع)
CLAUDE_MODEL=claude-sonnet-4-6
# منفذ الخادم الوسيط
PORT=8787

# ===== اختياري: تخزين مشترك =====
# بدونه تُحفظ الإجراءات في متصفح كل مستخدم على حدة.
# Redis بواجهة REST (Upstash أو Vercel KV).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== اختياري: المشغّل اليومي =====
# يمنع تشغيل /api/cron/daily من خارج Vercel
CRON_SECRET=

# ===== اختياري: الإرسال الفعلي للبريد =====
# معطّل ما لم تُضبط الثلاثة معاً. انظر تحذير «رمز الإرسال» في README.
RESEND_API_KEY=
MAIL_FROM=
MAIL_SEND_TOKEN=
