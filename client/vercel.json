{
  "framework": "vite",
  "functions": {
    "api/extract.js": {
      "maxDuration": 60
    },
    "api/evidence.js": {
      "maxDuration": 60
    },
    "api/cron/daily.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 5 * * *"
    }
  ]
}
